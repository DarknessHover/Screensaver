<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 换壁纸：normal 权限，安装即授予 -->
    <uses-permission android:name="android.permission.SET_WALLPAPER" />

    <!-- 重启后重新排程：normal -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- 精确闹钟特殊访问（API 31+）；能力不可用时应用会降级为非精确闹钟 -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <!-- 电池优化白名单引导。声明该权限后才能请求 ACTION_REQUEST_IGNORE_BATTERY_OPTIMIZATIONS；
         设置页不返回结果，因此回到前台时通过 PowerManager 复查真实状态。 -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <application
        android:name=".ScreensaverApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Screensaver">

        <!-- MainActivity 是唯一启动入口；Android 12+ 启动画面由 values-v31/themes.xml 配置。 -->
        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:theme="@style/Theme.Screensaver">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 开机、应用更新或精确闹钟权限恢复后：重排下一次切换 -->
        <receiver
            android:name=".scheduler.BootCompletedReceiver"
            android:exported="true"
            android:permission="android.permission.RECEIVE_BOOT_COMPLETED">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- 闹钟到点：计算当前生效规则并换壁纸（由本应用自身的 PendingIntent 触发，无需导出） -->
        <receiver
            android:name=".scheduler.WallpaperSwitchReceiver"
            android:exported="false" />

    </application>

</manifest>
